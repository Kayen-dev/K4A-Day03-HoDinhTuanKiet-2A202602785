# ==========================================
# TRAVEL PLANNING REACT AGENT CONFIGURATION
# Real API mode only. No mock LLM answers.
# ==========================================

# auto = Gemini first, fallback to GPT when Gemini is unavailable or out of quota.
LLM_PROVIDER=auto

# Primary provider
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Fallback provider
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# MCP Configuration
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8000
